{
  "name": "@dmsdc-ai/aigentry-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "description": "Aigentry orchestrator session/persistence library (ADR §6 #14 et al.)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node scripts/run-tests.mjs",
    "test:adr-mf": "tsc -p . && node --test dist/tests/session/deep-hierarchy.test.js dist/tests/session/no-implicit-inheritance.test.js dist/tests/session/digest-reproducibility.test.js dist/tests/session/boot-adapter-conformance.test.js dist/tests/session/persistence-protocol.test.js dist/tests/session/warn-mode-telemetry.test.js dist/tests/session/cycle-detection.test.js"
  },
  "dependencies": {
    "@dmsdc-ai/aigentry-logger": "^0.2.0",
    "@dmsdc-ai/aigentry-ssot": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./gate": "./dist/src/gate/index.js",
    "./session/persistence": "./dist/src/session/persistence/index.js",
    "./session/boot-adapter": "./dist/src/session/boot-adapter/index.js"
  },
  "main": "./dist/src/session/persistence/index.js",
  "types": "./dist/src/session/persistence/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmsdc-ai/aigentry-orchestrator.git"
  }
}
